<Window x:Class="FromZero.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FromZero" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="FromZero • Windows bakım istasyonu" Width="1320" Height="900" MinWidth="860" MinHeight="560" WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" FontFamily="{StaticResource RetroFont}" Foreground="{StaticResource Text}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <Style x:Key="CaptionButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#CEDCD3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="FontFamily" Value="{StaticResource RetroFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#503F5D55"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B9E2A7"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="WindowLayout" ClipToBounds="True">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
  <local:PixelWorld x:Name="World" Grid.RowSpan="4" IsHitTestVisible="False"/>
  <Border Grid.RowSpan="4" Background="#BC101921" IsHitTestVisible="False"/>
  <Border Grid.Row="0" Background="#20142129"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="Simge durumuna küçült" ToolTip="Küçült"/><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="MaximizeWindow" AutomationProperties.Name="Ekranı kapla veya geri yükle" ToolTip="Ekranı kapla / geri yükle"/><Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" Click="CloseWindow" AutomationProperties.Name="FromZero'yu kapat" ToolTip="Kapat"/></StackPanel><Image Source="Assets/FromZero.png" Width="16" Height="16" DockPanel.Dock="Left" Margin="16,0,6,0"/><TextBlock Text="FromZero" Margin="0,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#9AAFAE"/></DockPanel></Border>
  <Border Grid.Row="1" Background="#20142129">
   <Grid Margin="25,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="MachineLabel" VerticalAlignment="Center" FontFamily="{StaticResource RetroFont}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
    <ComboBox Grid.Column="1" x:Name="LanguageChoice" Width="125" MinHeight="28" Margin="0,0,16,0" ToolTip="Language"><ComboBoxItem Content="English"/><ComboBoxItem Content="Türkçe"/></ComboBox>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,8,0"/><TextBlock Text="YEREL ÇALIŞMA ALANI" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="2" HorizontalAlignment="Left" Width="209" Margin="8,8,8,10" CornerRadius="14" Background="#C018252D" BorderBrush="#303E535A" BorderThickness="1">
   <Grid Margin="8,14,8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="KONTROL ODASI" FontSize="10" Foreground="{StaticResource Muted}" Margin="12,0,0,12"/>
    <DockPanel Grid.Row="1" VerticalAlignment="Top">
     <Border DockPanel.Dock="Bottom" CornerRadius="10" BorderThickness="2" Margin="0,3,0,0">
      <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E64900" Offset="0"/><GradientStop x:Name="VoxxHighlight" Color="#FF7935" Offset="0.5"/><GradientStop Color="#FF5500" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
      <Button Click="OpenVoxx" AutomationProperties.Name="VoxxApp (Gaming Voice Chat)" ToolTip="Open voxx.app in your browser" Background="#233444" BorderThickness="0" Margin="0" Padding="8,4" HorizontalContentAlignment="Left">
       <StackPanel><TextBlock Text="VoxxApp ↗" FontSize="13" Foreground="#FF5500"/><TextBlock Text="Gaming Voice Chat" FontSize="10" Foreground="#B9CBC1"/></StackPanel>
      </Button>
     </Border>
     <UniformGrid x:Name="Navigation" Rows="8" Columns="1" MaxHeight="365" VerticalAlignment="Top"/>
    </DockPanel>
    <Button Grid.Row="2" x:Name="OtherToolsButton" Content="Diğer araçlar  ···" HorizontalContentAlignment="Left" Background="#182B34" BorderThickness="0" Padding="12,9" Margin="0,8,0,10"/>
    <TextBlock Grid.Row="3" x:Name="VersionLabel" FontSize="10" Foreground="#829A9A" Margin="12,0,0,0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="225,0,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" Padding="30,22,30,18"><StackPanel x:Name="Page"/></ScrollViewer>
   <Border Grid.Row="1" Background="#1B3035" BorderBrush="#496561" BorderThickness="0,1,0,0" Padding="18,12" x:Name="OperationPanel" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" x:Name="CancelOperation" Content="Durdur" Click="CancelCleanup" Visibility="Collapsed" Margin="14,0,0,0"/><StackPanel><TextBlock x:Name="OperationTitle" Foreground="{StaticResource Mint}" FontSize="13"/><ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0"/></StackPanel></DockPanel></Border>
  </Grid>
  <Border Grid.Row="3" Background="#101B23" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="HAZIR  /  Sistem değişiklikleri yalnızca seçtiğin işlemlerle uygulanır." VerticalAlignment="Center" FontFamily="{StaticResource RetroFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/><TextBlock Grid.Column="1" Text="SAVE. RESTORE. RESPAWN." HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource RetroFont}" FontSize="10" Foreground="#68817F"/></Grid></Border>
 </Grid>
</Window>








